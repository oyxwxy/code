rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return exists(/databases/$(database)/documents/meta/admin) && get(/databases/$(database)/documents/meta/admin).data.uid == request.auth.uid;
    }

    match /meta/{d} {
      allow read: if true;
      allow create: if d == 'admin' && request.auth.uid == request.resource.data.uid
                    && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    match /handles/{h} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // 아이디를 바꾸면 이전 아이디 문서에 'movedTo'(새 아이디)만 한 번 적을 수 있어요
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && !('movedTo' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['movedTo'])
        && request.resource.data.movedTo == getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle;
    }

    match /invites/{code} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      // 초대코드는 관리자만 만들 수 있어요
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.owner
        && request.resource.data.uses == 0
        && isAdmin();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.max
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if request.auth.uid == uid
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        && request.resource.data.inviteCount == 0
        && (
          (!exists(/databases/$(database)/documents/meta/admin) && request.resource.data.isAdmin == true
            && getAfter(/databases/$(database)/documents/meta/admin).data.uid == uid)
          ||
          (request.resource.data.isAdmin == false
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.uses
               < get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.max
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.uses
               == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.uses + 1
            && request.resource.data.invitedBy
               == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.owner
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.owner
               == get(/databases/$(database)/documents/meta/admin).data.uid)
        );
      allow update: if request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display', 'bio', 'theme'])
          ||
          // 아이디 바꾸기: 계정당 딱 1번 (handleChanged 가 이미 있으면 안 돼요)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handle', 'handleChanged'])
            && !('handleChanged' in resource.data)
            && request.resource.data.handleChanged == true
            && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
            && !exists(/databases/$(database)/documents/handles/$(request.resource.data.handle))
            && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid)
        );
    }

    match /posts/{id} {
      allow read: if resource.data.vis != 'private' || resource.data.owner == request.auth.uid;
      allow create: if request.auth.uid == request.resource.data.owner;
      allow update: if request.auth.uid == resource.data.owner && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth.uid == resource.data.owner;
    }

    match /bodies/{id} {
      allow read: if resource.data.vis in ['public', 'locked'] || resource.data.owner == request.auth.uid;
      allow create: if request.auth.uid == request.resource.data.owner;
      allow update: if request.auth.uid == resource.data.owner && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth.uid == resource.data.owner;
    }

    match /images/{id} {
      allow get: if true;
      allow create: if request.auth.uid == request.resource.data.owner && request.resource.data.d.size() < 950000;
      allow delete: if request.auth.uid == resource.data.owner;
    }

    // 이웃 배너 알림: 누가 내 배너를 가져갔는지 (문서 ID = 가져간 사람의 uid)
    match /notifs/{owner}/items/{from} {
      allow read: if request.auth != null && request.auth.uid == owner;
      allow create: if request.auth != null && request.auth.uid == from && from != owner
        && request.resource.data.keys().hasOnly(['at', 'read'])
        && request.resource.data.read == false
        && request.resource.data.at is number;
      allow update: if request.auth != null && (
        (request.auth.uid == from && from != owner
          && request.resource.data.keys().hasOnly(['at', 'read'])
          && request.resource.data.read == false
          && request.resource.data.at is number)
        || (request.auth.uid == owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])));
      allow delete: if request.auth != null && (request.auth.uid == owner || request.auth.uid == from);
    }

    match /users/{uid}/private/{d} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
